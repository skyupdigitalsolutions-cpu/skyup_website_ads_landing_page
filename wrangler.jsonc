{
  // Landing page (static assets) + lead-capture Worker in one deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skyup-website-ads-landing-page",
  "compatibility_date": "2026-08-08",

  // Worker entry (handles /api/*). Everything else is served from ./dist.
  "main": "src/worker.js",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* hits the Worker; all other paths serve the static site.
    "run_worker_first": ["/api/*"]
  },

  // Leads database. Create it, then paste the id below:
  //   npx wrangler d1 create skyup-leads
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skyup-leads",
      "database_id": "66eab627-0493-407e-8d87-f04f6f16077e"
    }
  ],

  "observability": { "enabled": true }
}
