{
  // Static-assets deploy: wrangler serves the built `dist` folder directly.
  // Because this config exists, wrangler skips framework auto-config
  // (which otherwise demands Vite >= 6.0.0).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skyup-website-ads-landing-page",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
